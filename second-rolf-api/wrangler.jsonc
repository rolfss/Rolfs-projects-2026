{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "second-rolf-api",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "keep_vars": true,
  "durable_objects": {
    "bindings": [{"name": "LOCAL_RELAY", "class_name": "LocalRelay"}]
  },
  "migrations": [{"tag": "v1-local-relay", "new_sqlite_classes": ["LocalRelay"]}],
  "ratelimits": [{"name": "SECOND_ROLF_RATE", "namespace_id": "26090807", "simple": {"limit": 10, "period": 60}}],
  "observability": {"enabled": false}
}
